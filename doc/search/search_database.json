ity Attributes Name Initial real(kind=8), public :: x real(kind=8), public :: y Type-Bound Procedures procedure, public :: somar => somar_vetores Método que soma o vetor atual com outro vetor. Read more… Functions public  function somar_reais (a, b) result(soma) Arguments Type Intent Optional Attributes Name real(kind=8), intent(in) :: a Primeiro número real(kind=8), intent(in) :: b Segundo número Return Value real(kind=8) Resultado da soma algébrica public  function somar_vetores (this, outro) result(resultado) Função interna que realiza a soma de dois tipos Vetor2D. Read more… Arguments Type Intent Optional Attributes Name class( Vetor2D ), intent(in) :: this type( Vetor2D ), intent(in) :: outro Return Value type( Vetor2D )","tags":"","url":"module\\example.html"},{"title":"ElementNode – Framed Structures","text":"Derived Types type, public :: Node Components Type Visibility Attributes Name Initial real, public :: x real, public :: y","tags":"","url":"module\\elementnode.html"},{"title":"main – Framed Structures","text":"Uses Example Variables Type Attributes Name Initial type( Vetor2D ) :: v1","tags":"","url":"program\\main.html"},{"title":"check – Framed Structures","text":"","tags":"","url":"program\\check.html"},{"title":"main.f90 – Framed Structures","text":"Source Code program main use Example , only : Vetor2D implicit none type ( Vetor2D ) :: v1 v1 = Vetor2D ( 1 d0 , 2 d0 ) print * , v1 % x end program main","tags":"","url":"sourcefile\\main.f90.html"},{"title":"Example.f90 – Framed Structures","text":"Source Code module Example !< @brief Módulo para exemplificar documentações. !< !< Apenas exemplifica como documentar adequadamente um código. implicit none type Vetor2D !< @brief Tipo derivado que representa um vetor no espaço 2D. !< !< Armazena as coordenadas cartesianas X e Y e fornece !< métodos para manipulação vetorial. real ( 8 ) :: x !< Coordenada cartesiana do eixo X. real ( 8 ) :: y !< Coordenada cartesiana do eixo Y. contains !> @brief Método que soma o vetor atual com outro vetor. procedure :: somar => somar_vetores end type contains function somar_reais ( a , b ) result ( soma ) !< @brief Calcula a soma de dois números reais de precisão dupla. !< !< @details Recebe dois números reais em precisão dupla e retorna a soma !< algébrica deles. !< !< ### Exemplo de Uso !< ```fortran !< use Example, only: somar_reais !< real(8) :: resultado !< resultado = somar_reais(5.5_8, 4.5_8) ! Retorna 10.0_8 !< ``` implicit none !> Primeiro número real ( 8 ), intent ( in ) :: a !> Segundo número real ( 8 ), intent ( in ) :: b !> Resultado da soma algébrica real ( 8 ) :: soma soma = a + b end function somar_reais function somar_vetores ( this , outro ) result ( resultado ) !! @brief Função interna que realiza a soma de dois tipos Vetor2D. !! !! Esta função implementa o procedimento vinculado `somar`. Ela recebe o próprio !! objeto que a chamou (`this`) e um segundo vetor para computar o resultado. !! !! ### Exemplo de Uso !! ```fortran !! type(Vetor2D) :: v1, v2, v3 !! v1 = Vetor2D(1.0_8, 2.0_8) !! v2 = Vetor2D(3.0_8, 4.0_8) !! v3 = v1%somar(v2) ! Retorna Vetor2D(4.0_8, 6.0_8) !! ``` class ( Vetor2D ), intent ( in ) :: this !< Objeto base (operando 1) type ( Vetor2D ), intent ( in ) :: outro !< Objeto somado (operando 2) type ( Vetor2D ) :: resultado !< A soma dos vetores resultado % x = this % x + outro % x resultado % y = this % y + outro % y end function somar_vetores end module","tags":"","url":"sourcefile\\example.f90.html"},{"title":"check.f90 – Framed Structures","text":"Source Code program check implicit none print * , \"Put some tests in here!\" end program check","tags":"","url":"sourcefile\\check.f90.html"},{"title":"ElementNode.f90 – Framed Structures","text":"Source Code module ElementNode implicit none type Node real :: x real :: y end type end module","tags":"","url":"sourcefile\\elementnode.f90.html"}]}